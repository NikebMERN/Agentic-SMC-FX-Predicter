# ---- Production environment template ---------------------------------------
# Copy values into Render Environment Variables. Do not commit real secrets.

APP_ENV=production
API_HOST=0.0.0.0
API_PORT=10000
CORS_ORIGINS=https://your-render-service.onrender.com

SECRET_KEY=replace_with_64_hex_chars

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_admin_password
ADMIN_USERNAME=admin

# Copy the exact Service URI/Host/Port from Aiven Quick Connect; do not guess the hostname.
# Example shape: mysql+pymysql://avnadmin:PASSWORD@EXACT-AIVEN-HOST:PORT/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=mysql+pymysql://USER:PASSWORD@EXACT-AIVEN-HOST:PORT/defaultdb?ssl-mode=REQUIRED

REDIS_URL=redis://default:PASSWORD@HOST:PORT
RATELIMIT_STORAGE_URI=redis://default:PASSWORD@HOST:PORT

DATA_PROVIDER=auto
OANDA_API_KEY=
OANDA_ENV=practice
ALPHA_VANTAGE_API_KEY=
ALLOW_CACHE_ONLY_PRODUCTION=false

MARKET_STREAMS_ENABLED=true
MAX_MARKET_STREAMS=20

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=replace_with_email_app_password
SMTP_FROM=your-email@gmail.com

TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=
BACKGROUND_SERVICES_ENABLED=true
SERVICE_ROLE=api

# Structured stdout is the source of truth on Render. Configure a Render log
# stream or external collector for retention and cross-service search.
LOG_FORMAT=json
LOG_TO_FILE=false
LOG_LEVEL=INFO

# Optional centralized exception tracking.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# Database pool settings are per API process. Keep total connections across
# Gunicorn processes and service instances below the database plan limit.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

SERVICE_HEARTBEAT_TTL_SECONDS=120
SYSTEM_RESTART_WEBHOOK=
