# ---- Production environment template ---------------------------------------
# Copy values into Render Environment Variables. Do not commit real secrets.

APP_ENV=production
API_HOST=0.0.0.0
API_PORT=10000
CORS_ORIGINS=https://your-render-service.onrender.com

SECRET_KEY=replace_with_64_hex_chars

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_admin_password
ADMIN_USERNAME=admin

# Aiven MySQL hosts normally start with mysql-...
# Example: mysql+pymysql://avnadmin:PASSWORD@mysql-SERVICE-PROJECT.a.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=mysql+pymysql://USER:PASSWORD@mysql-HOST.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED

REDIS_URL=redis://default:PASSWORD@HOST:PORT
RATELIMIT_STORAGE_URI=redis://default:PASSWORD@HOST:PORT

DATA_PROVIDER=auto
OANDA_API_KEY=
OANDA_ENV=practice
ALPHA_VANTAGE_API_KEY=
ALLOW_CACHE_ONLY_PRODUCTION=false

MARKET_STREAMS_ENABLED=true
MAX_MARKET_STREAMS=20

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=replace_with_email_app_password
SMTP_FROM=your-email@gmail.com

TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=
BACKGROUND_SERVICES_ENABLED=true
