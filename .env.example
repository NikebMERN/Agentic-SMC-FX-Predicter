# ---- Market data -----------------------------------------------------
# Preferred provider: OANDA v20. Free practice account works for data —
# create one at https://www.oanda.com, then Manage API Access -> Generate.
OANDA_API_KEY=your_oanda_v20_token_here
# practice (api-fxpractice) or live (api-fxtrade)
OANDA_ENV=practice
# auto: OANDA first, Alpha Vantage fallback, cache last. Or pin: oanda / alphavantage
DATA_PROVIDER=auto

# Fallback provider: https://www.alphavantage.co/support/#api-key (~25 req/day free)
ALPHA_VANTAGE_API_KEY=

# Candle interval used everywhere: 1min, 5min, 15min, 30min, 60min
DATA_INTERVAL=60min
# Leave empty to use the built-in 96-pair catalog (see utils/pairs.py)
# Or override: SUPPORTED_PAIRS=EUR/USD,GBP/USD,USD/JPY
# SUPPORTED_PAIRS=
# All candle timestamps are normalised to this clock (ICT kill-zone convention)
DATA_TZ=America/New_York
# ICT kill zones in the DATA_TZ clock
# KILLZONES=London=02:00-05:00,NewYork=07:00-10:00,LondonClose=10:00-12:00

# Skip live re-fetch when the pair's CSV is younger than this (minutes)
FETCH_COOLDOWN_MINUTES=5

# ---- API server --------------------------------------------------------
# production: set APP_ENV=production (development aliases: dev, develop, development)
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=5000
# REQUIRED in production — generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string
# production: set your domain(s), never "*" — e.g. https://your-domain.com
CORS_ORIGINS=*
# JWT access token lifetime (minutes) and refresh token lifetime (days)
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
# Rate limit storage: memory:// (single process) or redis://redis:6379/0
# RATELIMIT_STORAGE_URI=redis://redis:6379/0

# ---- Admin panel (http://host:5000/admin) --------------------------------
# production: set both with a strong ADMIN_PASSWORD (not a dictionary word)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# ---- HTTPS (Docker + Caddy) ---------------------------------------------
# production: set DOMAIN to your public hostname for automatic HTTPS
DOMAIN=
ACME_EMAIL=

# ---- Database (MySQL) ---------------------------------------------------
# production: use MySQL — set DATABASE_URL or MYSQL_* (not sqlite)
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=smc_trader
# Full override (e.g. sqlite:///./smc.db for local dev without MySQL)
# DATABASE_URL=
# Docker only:
# MYSQL_ROOT_PASSWORD=

# ---- Background jobs ----------------------------------------------------
OUTCOME_MONITOR_INTERVAL_SEC=60
HEALTH_MONITOR_INTERVAL_SEC=120
ALERT_FAILURE_THRESHOLD=3

# ---- SMTP (password-reset emails; Gmail needs an App Password) -----------
# production: required for user/admin password reset without dev_code fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Default free-trial prediction quota (shared web + Telegram)
DEFAULT_SIGNALS_QUOTA=5
# Hours after a prediction before user feedback + market verification (default 2)
FEEDBACK_DUE_HOURS=2

# ---- ML platform (meta-labeling) ----------------------------------------
# active = use promoted meta-model (default); fresh = deprecated legacy path
# ml_mode=active
# NIGHTLY_RETRAIN_CRON=0 2 * * *
# NIGHTLY_RETRAIN_TZ=America/New_York
# REDIS_URL=redis://localhost:6379/0
# MODEL_PROMOTION_ENABLED=false
# MODEL_ARTIFACT_DIR=./model/artifacts
# EXPORT_STORAGE_DIR=./exports
# EXPORT_EXPIRY_HOURS=24
# OANDA_ACCOUNT_ID=your_practice_account_id

# ---- Telegram (timeouts / proxy if api.telegram.org is slow or blocked) ----
# TELEGRAM_BOT_ENABLED=false   # disable bot thread entirely (web/API still works)
# TELEGRAM_CONNECT_TIMEOUT=30
# TELEGRAM_READ_TIMEOUT=30
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080

# ---- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
